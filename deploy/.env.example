# Copy to deploy/.env. No passwords or account tokens belong here.
OPENCODEX_IMAGE=opencodex-custom:20261029-4
OPENCODEX_PLATFORM=linux/amd64
OPENCODEX_BIND_ADDRESS=127.0.0.1
OPENCODEX_PORT=10100
# Caps, not measured requirements or preallocated memory. Inspect host free RAM first.
OPENCODEX_MEMORY_LIMIT=640m
OPENCODEX_MEMORY_RESERVATION=384m
OPENCODEX_MEMORY_SWAP_LIMIT=896m
OPENCODEX_CPUS=1.0

# Optional: one exact private HTTP dashboard origin, e.g. http://192.168.1.10:10100
# HTTP sessions are unencrypted. Empty keeps HTTPS/loopback-only remember.
OPENCODEX_HTTP_REMEMBER_ORIGIN=
