# Existing CentOS 7 x86_64 host with Docker 26.1.4 / Compose 2.27.1.
# Resource caps, not reserved physical allocations. Leave room for other services.
OPENCODEX_IMAGE=opencodex-custom:20261029-5
OPENCODEX_PLATFORM=linux/amd64
OPENCODEX_BIND_ADDRESS=127.0.0.1
OPENCODEX_PORT=10100
OPENCODEX_MEMORY_LIMIT=2g
OPENCODEX_MEMORY_RESERVATION=512m
OPENCODEX_MEMORY_SWAP_LIMIT=3g
OPENCODEX_CPUS=2.0

# Optional: one exact private HTTP dashboard origin, e.g. http://192.168.1.10:10100
# HTTP sessions are unencrypted. Empty keeps HTTPS/loopback-only remember.
OPENCODEX_HTTP_REMEMBER_ORIGIN=
